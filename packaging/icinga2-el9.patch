## EL9 compatibility patch for the Icinga 2 spec file.
##
## This file is intentionally a no-op placeholder: as of the last review,
## the Fedora 44 icinga2.spec builds unchanged inside the EL9 mock chroot
## defined in mock/icinga2-el9-x86_64.cfg once the release tag is rewritten
## (which scripts/build-icinga2-el9.sh does automatically and unconditionally,
## independent of this patch).
##
## scripts/build-icinga2-el9.sh detects whether this file contains real
## unified-diff hunks (lines starting with "---", "+++", or "@@"). Since it
## does not, the build script logs that no compatibility patch was applied
## and proceeds with the unmodified (release-rewritten) spec file.
##
## If a future Fedora 44 SRPM introduces an EL9-incompatible construct
## (e.g. a BuildRequires only available in Fedora, a %fedora conditional
## that excludes EL9, a macro not defined on EL9), replace the contents of
## this file with a minimal `diff -u` against the extracted icinga2.spec,
## in the form:
##
##   --- icinga2.spec.orig
##   +++ icinga2.spec
##   @@ -N,M +N,M @@
##    context line
##   -removed line
##   +added line
##    context line
##
## Keep changes minimal, reviewable, and scoped strictly to EL9 build
## compatibility. Do not alter upstream Source0 versions or functionality.
##
## Hunks below with a "lib/otel/..." (or other non-*.spec) path are applied
## by scripts/build-icinga2-el9.sh against the *extracted upstream source
## tarball* (not the SRPM top-level files), then the tarball is repacked
## before rpmbuild -bs runs. Hunks targeting the spec file itself are
## applied directly against the SRPM top-level extraction directory.
##
## EL9 ships protobuf/protoc 3.14, which requires the
## --experimental_allow_proto3_optional flag for .proto files using proto3
## "optional" fields (Fedora ships a newer protoc where this is the
## default). Without it, protoc fails on
## opentelemetry/proto/metrics/v1/metrics.proto with:
##   "This file contains proto3 optional fields, but
##    --experimental_allow_proto3_optional was not set."
## Pass the flag explicitly via CMake's protobuf_generate(PROTOC_OPTIONS ...)
## (supported since CMake 3.28; EL9's cmake is 3.31).
--- a/lib/otel/CMakeLists.txt
+++ b/lib/otel/CMakeLists.txt
@@ -15,6 +15,7 @@
   #
   # [^1]: https://protobuf.dev/programming-guides/proto3/#options
   PLUGIN_OPTIONS lite
+  PROTOC_OPTIONS --experimental_allow_proto3_optional
   OUT_VAR otel_PROTO_SRCS
   IMPORT_DIRS "${ICINGA2_OPENTELEMETRY_PROTOS_DIR}"
   PROTOS

## %install hardcodes DESTDIR/install paths to a Fedora-specific nested
## build directory (%_topdir/BUILD/icinga2-VERSION-build/BUILDROOT) that
## only matches rpm's actual packaging %{buildroot} on Fedora's newer
## redhat-rpm-config (which redefines %{buildroot} for vpath/out-of-tree
## cmake builds). EL9's redhat-rpm-config uses the standard
## %{_topdir}/BUILDROOT/%{NAME}-%{VERSION}-%{RELEASE}.%{ARCH} layout, so
## on EL9 nothing actually lands in %{buildroot} and %files fails with
## "File not found" for every path. Fix: install into the portable
## %{buildroot} macro directly instead of the hardcoded Fedora path.
--- a/icinga2.spec
+++ b/icinga2.spec
@@ -183,25 +183,25 @@
 cd -
 
 %install
-DESTDIR="%_topdir/BUILD/icinga2-2.16.5-build/BUILDROOT" ninja-build install
+DESTDIR="%{buildroot}" ninja-build install
 
-install -D -m 0644 etc/initsystem/icinga2.service.limits.conf %_topdir/BUILD/icinga2-2.16.5-build/BUILDROOT/etc/systemd/system/icinga2.service.d/limits.conf
+install -D -m 0644 etc/initsystem/icinga2.service.limits.conf %{buildroot}/etc/systemd/system/icinga2.service.d/limits.conf
 
-rm -f %_topdir/BUILD/icinga2-2.16.5-build/BUILDROOT//etc/icinga2/features-enabled/*.conf
+rm -f %{buildroot}//etc/icinga2/features-enabled/*.conf
 
 cd tools/selinux
 for selinuxvariant in mls targeted
 do
-install -d %_topdir/BUILD/icinga2-2.16.5-build/BUILDROOT/usr/share/selinux/${selinuxvariant}
+install -d %{buildroot}/usr/share/selinux/${selinuxvariant}
 install -p -m 644 icinga2.pp.${selinuxvariant} \
-%_topdir/BUILD/icinga2-2.16.5-build/BUILDROOT/usr/share/selinux/${selinuxvariant}/icinga2.pp
+%{buildroot}/usr/share/selinux/${selinuxvariant}/icinga2.pp
 done
 cd -
 
-install -D -m 0644 tools/syntax/vim/syntax/icinga2.vim %_topdir/BUILD/icinga2-2.16.5-build/BUILDROOT/usr/share/vim/vimfiles/syntax/icinga2.vim
-install -D -m 0644 tools/syntax/vim/ftdetect/icinga2.vim %_topdir/BUILD/icinga2-2.16.5-build/BUILDROOT/usr/share/vim/vimfiles/ftdetect/icinga2.vim
+install -D -m 0644 tools/syntax/vim/syntax/icinga2.vim %{buildroot}/usr/share/vim/vimfiles/syntax/icinga2.vim
+install -D -m 0644 tools/syntax/vim/ftdetect/icinga2.vim %{buildroot}/usr/share/vim/vimfiles/ftdetect/icinga2.vim
 
-install -D -m 0644 tools/syntax/nano/icinga2.nanorc %_topdir/BUILD/icinga2-2.16.5-build/BUILDROOT/usr/share/nano/icinga2.nanorc
+install -D -m 0644 tools/syntax/nano/icinga2.nanorc %{buildroot}/usr/share/nano/icinga2.nanorc
 
 %check
 export CTEST_OUTPUT_ON_FAILURE=1
